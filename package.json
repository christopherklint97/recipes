{
  "name": "recipes",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3210 --host",
    "start": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "bun --bun vite build",
    "build:icons": "bun run scripts/build-icons.ts",
    "preview": "bun --bun vite preview",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "hash-password": "bun run scripts/hash-password.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "entities": "^8.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.25.0",
    "nitro": "npm:nitro-nightly@^3.0.1-20260722-103619-0192bba0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
